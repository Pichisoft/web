rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Subcolección de datos (pichisoft-datos.js)
      match /data/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Todo lo demás queda denegado por defecto
  }
}
